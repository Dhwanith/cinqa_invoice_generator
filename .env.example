# Cinqa Invoice Generator — Environment Variables
# Copy to .env and fill in your values.
# Required vars are marked with [required]. All others have safe defaults.

# ── Supabase ──────────────────────────────────────────────────────────────────
# [required] Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# [required] Service role key — bypasses RLS; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# UUID of the default organization row (matches supabase/seed.sql)
SUPABASE_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# ── App server ────────────────────────────────────────────────────────────────
# Port the Express app listens on
APP_PORT=3010

# [required] Operator login credentials
APP_AUTH_USERNAME=operator
APP_AUTH_PASSWORD=change-me-in-production

# [required] Secret used to sign session tokens (min 32 random chars)
APP_SESSION_SECRET=replace-with-a-long-random-string

# Session lifetime in hours
APP_SESSION_TTL_HOURS=12

# Number of reverse proxies in front of the app (for IP/HTTPS detection)
APP_TRUST_PROXY=1

# Force secure cookies regardless of detected protocol (set true in production)
APP_COOKIE_SECURE=false

# ── Company profile (printed on every invoice) ────────────────────────────────
COMPANY_NAME=Cinqa Tech Solutions LLP
COMPANY_GSTIN=24AAWFC2925N1ZX
COMPANY_PAN=AAWFC2925N
COMPANY_TAN=SRTC05319G
COMPANY_STATE=Gujarat
COMPANY_STATE_CODE=24
COMPANY_ADDRESS_LINE_1=47/107, Soham Park, Saraswat Nagar
COMPANY_ADDRESS_LINE_2=Piplod, Surat - 395007, GJ(24)
COMPANY_EMAIL=tarunchelumalla@cinqa.space
COMPANY_WEBSITE=www.cinqa.space
AUTHORIZED_SIGNATORY=Authorized Signatory

# ── Bank details (payment section on invoice) ─────────────────────────────────
BANK_ACCOUNT_NAME=CINQA TECH SOLUTIONS LLP
BANK_NAME=Axis Bank
BANK_ACCOUNT_NUMBER=926020012433774
BANK_BRANCH_NAME=Parle Point, Surat
BANK_IFSC=UTIB0005112

# ── Invoice defaults ──────────────────────────────────────────────────────────
# Default payment terms shown on tax invoices
PAYMENT_TERMS_DAYS=10

# Default SAC code used when a client or line item doesn't specify one
DEFAULT_SAC=998314

# GST rate applied to tax invoices (18% = 0.18)
DEFAULT_GST_RATE=0.18

# ── External webhook (POST /webhook/create-invoice) ──────────────────────────
# Optional API key for securing the public webhook endpoint.
# If set, callers must send x-webhook-secret or x-api-key header with this value.
# Leave unset for open access (development only).
WEBHOOK_API_KEY=

# ── PDF microservice (npm run pdf:service) ────────────────────────────────────
PDF_SERVICE_PORT=3001

# ── PDF background worker (npm run pdf:worker) ────────────────────────────────
# How often the worker polls for pending jobs (milliseconds)
PDF_WORKER_POLL_MS=10000

# How many times to retry a failed PDF job before giving up
PDF_WORKER_MAX_ATTEMPTS=3

# Lifetime of Supabase Storage signed URLs in seconds (3600 = 1 hour)
PDF_SIGNED_URL_TTL=3600
